---
/*
  Layout base: todas las páginas lo usan.
  Contiene el <head>, el encabezado, el pie de página y arranca las animaciones.
  Cada página le pasa su título (del mapa del sitio); la descripción sale de src/datos/sitio.ts.
*/
import "../styles/global.css";
import Encabezado from "../components/Encabezado.astro";
import PiePagina from "../components/PiePagina.astro";
import { sitio } from "../datos/sitio";

interface Props {
  title: string;
  description?: string;
}

const { title, description = sitio.descripcion } = Astro.props;
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const imagenOG = new URL("/OG.jpeg", Astro.site).href;
---

<!doctype html>
<html lang="es" data-animacion={sitio.animacion}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={sitio.nombre} />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- etiquetas -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagenOG} />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>

    <!-- Activa el estado inicial de las animaciones antes de pintar la página -->
    <script is:inline>
      if (
        document.documentElement.dataset.animacion !== "ninguna" &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("animar");
      }
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only bg-marca px-4 py-2 font-bold text-marca-contraste focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Saltar al contenido
    </a>

    <Encabezado />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <PiePagina />

    <script>
      import { iniciarAnimaciones } from "../scripts/animaciones";

      iniciarAnimaciones();
    </script>
  </body>
</html>
