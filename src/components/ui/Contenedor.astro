---
/*
  Contenedor: centra el contenido y le da el ancho máximo del sitio.
  Ancho aprobado para Sabrina: max-w-5xl.

  Uso:
    <Contenedor>...contenido...</Contenedor>
*/

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<div class:list={["mx-auto w-full max-w-5xl px-4 sm:px-6", clase]}>
  <slot />
</div>
